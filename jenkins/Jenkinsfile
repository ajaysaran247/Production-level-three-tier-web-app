pipeline {

    agent any

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '235229002060'
        ECR_REPOSITORY = 'three-tier-backend'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('AWS Identity Check') {
            steps {
                sh '''
                    echo "Checking AWS identity..."
                    aws sts get-caller-identity
                '''
            }
        }

        stage('Backend Test') {
            steps {
                dir('application/backend') {
                    sh '''
                        echo "Python version:"
                        python3 --version

                        echo "pip version:"
                        python3 -m pip --version

                        echo "Installing backend dependencies..."
                        python3 -m pip install --user -r requirements.txt
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('application/backend') {
                    sh '''
                        echo "Building backend Docker image..."

                        docker build \
                          -t ${ECR_REPOSITORY}:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    echo "Logging into Amazon ECR..."

                    aws ecr get-login-password \
                      --region ${AWS_REGION} | \
                    docker login \
                      --username AWS \
                      --password-stdin \
                      ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }

        stage('Push Backend Image') {
            steps {
                sh '''
                    IMAGE_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${BUILD_NUMBER}"

                    echo "Tagging image:"
                    echo "${IMAGE_URI}"

                    docker tag \
                      ${ECR_REPOSITORY}:${BUILD_NUMBER} \
                      ${IMAGE_URI}

                    echo "Pushing image to ECR..."

                    docker push ${IMAGE_URI}
                '''
            }
        }
    }

    post {
        success {
            echo 'JENKINS BACKEND PIPELINE SUCCESSFUL'
        }

        failure {
            echo 'JENKINS BACKEND PIPELINE FAILED'
        }
    }
}
