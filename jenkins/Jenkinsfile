pipeline {

    agent any

    environment {
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '235229002060'
        ECR_REPOSITORY = 'three-tier-backend'
        ASG_NAME       = 'three-tier-asg'
        CONTAINER_NAME = 'three-tier-backend'
        CONTAINER_PORT = '5000'
        S3_BUCKET      = 'three-tier-app-frontend-bucket'
    }

    stages {

        // =========================================================
        // CHECKOUT
        // =========================================================
        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        // =========================================================
        // AWS IDENTITY
        // =========================================================
        stage('AWS Identity Check') {
            steps {
                sh '''
                    echo "======================================"
                    echo "AWS IDENTITY"
                    echo "======================================"

                    aws sts get-caller-identity
                '''
            }
        }


        // =========================================================
        // DISCOVER ASG INSTANCES
        // =========================================================
        stage('Discover ASG Instances') {
            steps {
                script {

                    sh '''
                        echo "======================================"
                        echo "DISCOVERING APPLICATION INSTANCES"
                        echo "======================================"

                        aws autoscaling describe-auto-scaling-groups \
                          --auto-scaling-group-names ${ASG_NAME} \
                          --region ${AWS_REGION} \
                          --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId' \
                          --output text
                    '''

                    env.APPLICATION_INSTANCE_IDS = sh(
                        script: '''
                            aws autoscaling describe-auto-scaling-groups \
                              --auto-scaling-group-names ${ASG_NAME} \
                              --region ${AWS_REGION} \
                              --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId' \
                              --output text
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!env.APPLICATION_INSTANCE_IDS) {
                        error("No InService instances found in ${ASG_NAME}")
                    }

                    echo "Application instances:"
                    echo env.APPLICATION_INSTANCE_IDS
                }
            }
        }


        // =========================================================
        // GET ALB DNS (used by frontend to reach backend)
        // =========================================================
        stage('Get ALB DNS') {
            steps {
                script {
                    env.ALB_DNS = sh(
                        script: '''
                            aws elbv2 describe-load-balancers \
                              --query "LoadBalancers[?contains(LoadBalancerName, 'three-tier')].DNSName" \
                              --output text \
                              --region ${AWS_REGION}
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!env.ALB_DNS) {
                        error("Could not find ALB DNS name. Check the LoadBalancerName filter matches your Terraform-created ALB.")
                    }

                    echo "======================================"
                    echo "ALB DNS: ${env.ALB_DNS}"
                    echo "======================================"
                }
            }
        }


        // =========================================================
        // BACKEND TEST
        // =========================================================
        stage('Backend Test') {
            steps {
                dir('application/backend') {
                    sh '''
                        echo "======================================"
                        echo "BACKEND TEST"
                        echo "======================================"

                        python3 --version
                        python3 -m pip --version

                        echo "Installing backend dependencies..."

                        python3 -m pip install --user -r requirements.txt

                        echo "Backend dependencies installed successfully."
                    '''
                }
            }
        }


        // =========================================================
        // DOCKER BUILD
        // =========================================================
        stage('Docker Build') {
            steps {
                dir('application/backend') {
                    sh '''
                        echo "======================================"
                        echo "DOCKER BUILD"
                        echo "======================================"

                        docker build \
                          -t ${ECR_REPOSITORY}:${BUILD_NUMBER} .

                        echo "Docker build completed successfully."
                    '''
                }
            }
        }


        // =========================================================
        // ECR LOGIN
        // =========================================================
        stage('ECR Login') {
            steps {
                sh '''
                    echo "======================================"
                    echo "ECR LOGIN"
                    echo "======================================"

                    aws ecr get-login-password \
                      --region ${AWS_REGION} | \
                    docker login \
                      --username AWS \
                      --password-stdin \
                      ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                    echo "ECR login successful."
                '''
            }
        }


        // =========================================================
        // PUSH IMAGE TO ECR
        // =========================================================
        stage('Push to ECR') {
            steps {
                sh '''
                    echo "======================================"
                    echo "PUSHING IMAGE TO ECR"
                    echo "======================================"

                    IMAGE_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${BUILD_NUMBER}"

                    echo "Image:"
                    echo "${IMAGE_URI}"

                    docker tag \
                      ${ECR_REPOSITORY}:${BUILD_NUMBER} \
                      ${IMAGE_URI}

                    docker push ${IMAGE_URI}

                    echo "Docker image pushed successfully."
                '''
            }
        }


        // =========================================================
        // DEPLOY BACKEND TO ALL ASG INSTANCES
        // =========================================================
        stage('Deploy Backend to ASG') {
            steps {
                sh '''
                    echo "======================================"
                    echo "DEPLOYING BACKEND TO ASG INSTANCES"
                    echo "======================================"

                    IMAGE_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${BUILD_NUMBER}"

                    echo "Image URI:"
                    echo "${IMAGE_URI}"

                    for INSTANCE_ID in ${APPLICATION_INSTANCE_IDS}
                    do

                        echo ""
                        echo "--------------------------------------"
                        echo "Deploying to: ${INSTANCE_ID}"
                        echo "--------------------------------------"

                        COMMAND_ID=$(aws ssm send-command \
                          --region ${AWS_REGION} \
                          --instance-ids ${INSTANCE_ID} \
                          --document-name "AWS-RunShellScript" \
                          --parameters "commands=[
                            \\"aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com\\",
                            \\"docker pull ${IMAGE_URI}\\",
                            \\"docker stop ${CONTAINER_NAME} || true\\",
                            \\"docker rm ${CONTAINER_NAME} || true\\",
                            \\"docker run -d --name ${CONTAINER_NAME} --restart unless-stopped -p ${CONTAINER_PORT}:${CONTAINER_PORT} ${IMAGE_URI}\\"
                          ]" \
                          --query 'Command.CommandId' \
                          --output text)

                        echo "SSM Command ID: ${COMMAND_ID}"
                        echo "Waiting for deployment on ${INSTANCE_ID}..."

                        STATUS="Pending"

                        for i in $(seq 1 30)
                        do

                            STATUS=$(aws ssm get-command-invocation \
                              --region ${AWS_REGION} \
                              --command-id ${COMMAND_ID} \
                              --instance-id ${INSTANCE_ID} \
                              --query 'Status' \
                              --output text 2>/dev/null || echo "Pending")

                            echo "Current status: ${STATUS}"

                            if [ "$STATUS" = "Success" ]; then
                                break
                            fi

                            if [ "$STATUS" = "Failed" ] || \
                               [ "$STATUS" = "Cancelled" ] || \
                               [ "$STATUS" = "TimedOut" ]; then

                                echo "Deployment FAILED on ${INSTANCE_ID}"

                                aws ssm get-command-invocation \
                                  --region ${AWS_REGION} \
                                  --command-id ${COMMAND_ID} \
                                  --instance-id ${INSTANCE_ID}

                                exit 1
                            fi

                            sleep 5

                        done

                        if [ "$STATUS" != "Success" ]; then
                            echo "Deployment timed out on ${INSTANCE_ID}"
                            exit 1
                        fi

                        echo "Deployment successful on ${INSTANCE_ID}"

                        aws ssm get-command-invocation \
                          --region ${AWS_REGION} \
                          --command-id ${COMMAND_ID} \
                          --instance-id ${INSTANCE_ID}

                    done

                    echo ""
                    echo "======================================"
                    echo "ALL ASG INSTANCES DEPLOYED"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // BACKEND HEALTH CHECK
        // =========================================================
        stage('Backend Health Check') {
            steps {
                sh '''
                    echo "======================================"
                    echo "BACKEND HEALTH CHECK"
                    echo "======================================"

                    for INSTANCE_ID in ${APPLICATION_INSTANCE_IDS}
                    do

                        echo ""
                        echo "Checking ${INSTANCE_ID}"

                        COMMAND_ID=$(aws ssm send-command \
                          --region ${AWS_REGION} \
                          --instance-ids ${INSTANCE_ID} \
                          --document-name "AWS-RunShellScript" \
                          --parameters "commands=[
                            \\"docker ps --filter name=${CONTAINER_NAME}\\",
                            \\"curl -f http://localhost:${CONTAINER_PORT}/api/health || exit 1\\",
                            \\"curl -f http://localhost:${CONTAINER_PORT}/api/database || exit 1\\"
                          ]" \
                          --query 'Command.CommandId' \
                          --output text)

                        echo "Health command ID: ${COMMAND_ID}"

                        STATUS="Pending"

                        for i in $(seq 1 20)
                        do

                            STATUS=$(aws ssm get-command-invocation \
                              --region ${AWS_REGION} \
                              --command-id ${COMMAND_ID} \
                              --instance-id ${INSTANCE_ID} \
                              --query 'Status' \
                              --output text 2>/dev/null || echo "Pending")

                            echo "Health status: ${STATUS}"

                            if [ "$STATUS" = "Success" ]; then
                                break
                            fi

                            if [ "$STATUS" = "Failed" ] || \
                               [ "$STATUS" = "Cancelled" ] || \
                               [ "$STATUS" = "TimedOut" ]; then
                                break
                            fi

                            sleep 5

                        done

                        aws ssm get-command-invocation \
                          --region ${AWS_REGION} \
                          --command-id ${COMMAND_ID} \
                          --instance-id ${INSTANCE_ID}

                        if [ "$STATUS" != "Success" ]; then
                            echo "Health check FAILED on ${INSTANCE_ID}"
                            exit 1
                        fi

                        echo "Health check PASSED on ${INSTANCE_ID}"

                    done

                    echo ""
                    echo "======================================"
                    echo "ALL BACKEND HEALTH CHECKS PASSED"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // FRONTEND BUILD
        // =========================================================
        stage('Frontend Build') {
            steps {
                dir('application/frontend') {
                    sh '''
                        echo "======================================"
                        echo "FRONTEND BUILD"
                        echo "======================================"

                        echo "Writing environment config..."
                        echo "REACT_APP_API_URL=http://${ALB_DNS}" > .env
                        cat .env

                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version

                        echo ""
                        echo "Cleaning old node_modules..."
                        rm -rf node_modules

                        echo ""
                        echo "Cleaning npm cache..."
                        npm cache clean --force

                        echo ""
                        echo "Installing frontend dependencies..."
                        npm install

                        echo ""
                        echo "Building React application..."
                        npm run build

                        echo ""
                        echo "Frontend build completed successfully."

                        echo ""
                        echo "Build directory:"
                        ls -lah build/
                    '''
                }
            }
        }


        // =========================================================
        // DEPLOY FRONTEND TO S3
        // =========================================================
        stage('Deploy Frontend to S3') {
            steps {
                dir('application/frontend') {
                    sh '''
                        echo "======================================"
                        echo "DEPLOY FRONTEND TO S3"
                        echo "======================================"

                        aws s3 sync build/ \
                          s3://${S3_BUCKET}/ \
                          --delete \
                          --region ${AWS_REGION}

                        echo ""
                        echo "Frontend uploaded successfully."
                    '''
                }
            }
        }


        // =========================================================
        // FRONTEND VERIFICATION
        // =========================================================
        stage('Frontend Verification') {
            steps {
                sh '''
                    echo "======================================"
                    echo "FRONTEND VERIFICATION"
                    echo "======================================"

                    echo "Checking index.html..."

                    aws s3api head-object \
                      --bucket ${S3_BUCKET} \
                      --key index.html \
                      --region ${AWS_REGION}

                    echo ""
                    echo "Frontend index.html verified successfully."

                    echo ""
                    echo "Checking S3 website..."

                    curl -I \
                      http://${S3_BUCKET}.s3-website-us-east-1.amazonaws.com/

                    echo ""
                    echo "Frontend verification completed."
                '''
            }
        }
    }


    // =============================================================
    // POST ACTIONS
    // =============================================================
    post {

        success {
            echo '''
            ======================================
            FULL CI/CD PIPELINE SUCCESSFUL
            ======================================

            Backend:
                Python
                Docker
                ECR
                ASG
                SSM
                RDS

            Frontend:
                React
                S3
                ALB DNS injected at build time

            Deployment:
                SUCCESS

            ======================================
            '''
        }

        failure {
            echo '''
            ======================================
            FULL CI/CD PIPELINE FAILED
            ======================================

            Check the failed stage above.

            ======================================
            '''
        }
    }
}
